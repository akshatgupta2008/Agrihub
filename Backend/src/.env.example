PORT=
MONGO_URI=
MONGODB_URI=
# Optional: force a database name (avoids defaulting to the "test" database)
MONGO_DB_NAME=agrihub
# Local fallback for dev (used when MONGO_URI is missing or Atlas SRV DNS is blocked)
MONGO_LOCAL_URI=mongodb://127.0.0.1:27017/agrihub

# Optional: override DNS servers used by Node for MongoDB SRV lookups.
# Set this if `mongodb+srv://...` fails with `querySrv ECONNREFUSED`.
# Example:
# DNS_SERVERS=1.1.1.1,8.8.8.8
DNS_SERVERS=

# Optional: allowlist for frontend origins (comma-separated)
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
CORS_ORIGINS=

# Cookie settings (optional)
# COOKIE_SAMESITE=strict|lax|none
COOKIE_SAMESITE=strict
# COOKIE_SECURE=true|false (default: true in non-dev)
# COOKIE_SECURE=true
# COOKIE_DOMAIN=your-domain.com
# COOKIE_DOMAIN=
JWT_SECRET=
ADMIN_REGISTER_TOKEN=

# Optional: Flask gesture service bridge
GESTURE_SERVICE_URL=http://localhost:5001
GESTURE_SERVICE_TIMEOUT_MS=8000

# Cloudinary (PDF reports)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_REPORTS_FOLDER=agrihub/reports

# Optional: enable online appointment Meet links via Google Calendar API
# Current implementation expects a service account (client email + private key)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
GOOGLE_TIMEZONE=

NODE_ENV=
